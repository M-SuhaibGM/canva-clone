# MongoDB connection string (Prisma)
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/canva?retryWrites=true&w=majority"

# NextAuth - REQUIRED. Without NEXTAUTH_SECRET the middleware cannot read the
# session cookie, so every login bounces back to the login page.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google sign in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (uploads + AI images). The old lowercase names still work.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stability AI (AI image generation)
STABILITY_API_KEY=""

# PayPal (premium upgrade)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
FRONTEND_URL="http://localhost:3000"
PREMIUM_PRICE_USD="500"
